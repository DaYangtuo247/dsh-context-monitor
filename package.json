{
  "name": "dsh-context-monitor",
  "version": "0.1.0",
  "description": "Context usage for DeepSeek Harness sessions: a compact breakdown popover in the composer, plus a detailed 'Context Lens' tab in the conversation's top view row with every category, node, tool, system prompt section, skill and growth trend.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p . --noEmit",
    "check": "node build.mjs && node ./scripts/verify-corner-shape.mjs . && node .verify/smoke.mjs"
  },
  "devDependencies": {
    "sass": "1.108.2",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DaYangtuo247/dsh-context-monitor.git"
  },
  "homepage": "https://github.com/DaYangtuo247/dsh-context-monitor#readme",
  "bugs": {
    "url": "https://github.com/DaYangtuo247/dsh-context-monitor/issues"
  }
}
